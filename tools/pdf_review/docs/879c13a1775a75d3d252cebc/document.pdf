   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">WENZHOU, CHINA - AUGUST 27: Residents rest at a disaster relief shelter set up at Wenzhou Foreign Language School on August 27, 2026 in Wenzhou, Zhejiang Province of China. Nearly 300 workers from 10 construction sites have been evacuated to the shelter as Wenzhou authorities raised the typhoon emergency response to Level I while Typhoon Shadel approaches the Zhejiang coast. (Photo by Wu Junyi/China News Service/VCG via Getty Images)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <plus:Licensor>
    <rdf:Seq>
     <rdf:li
      plus:LicensorURL="https://www.gettyimages.com/detail/2292311480?utm_medium=organic&amp;utm_source=google&amp;utm_campaign=iptcurl"/>
    </rdf:Seq>
   </plus:Licensor>
  </rdf:Description>
